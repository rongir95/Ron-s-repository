{
  "name": "stock-portfolio-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Track individual stock portfolios with near-real-time market data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "VITE_DEFAULT_PROVIDER=yahoo-relay npm run build && node scripts/build-standalone.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx src/lib/calc.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
